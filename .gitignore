# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust & Tauri build target
target/
**/target/
src-tauri/target/

# Python cache
__pycache__/
*.pyc

# Tauri generated schemas
src-tauri/gen/

.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore raw uncompressed AppImages over 100MB
*.AppImage

# Android build artefacts (Tauri-generated Gradle project)
# Note: src-tauri/gen/ is already ignored above — these are extra safety rules
src-tauri/gen/android/.gradle/
src-tauri/gen/android/app/build/
src-tauri/gen/android/local.properties
src-tauri/gen/android/.idea/

# Android output packages
*.apk
*.aab
*.apks

# Android keystore (never commit signing keys)
*.jks
*.keystore
release-keystore.properties
